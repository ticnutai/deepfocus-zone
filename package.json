{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "concurrently -k -n vite,electron -c blue,magenta \"vite\" \"wait-on http://localhost:8080 && cross-env ELECTRON_DEV=1 electron .\"",
    "electron:build": "cross-env BUILD_TARGET=electron vite build",
    "electron:preview": "npm run electron:build && electron .",
    "electron:dist": "npm run electron:build && electron-builder",
    "android:build": "npm run build && npx cap sync android",
    "android:bundle:release": "npm run android:build && cd android && gradlew.bat bundleRelease",
    "android:publish:internal": "npm run android:build && cd android && gradlew.bat publishReleaseBundle --track=internal",
    "android:publish:internal-sharing": "npm run android:build && cd android && gradlew.bat uploadReleasePrivateBundle",
    "android:open": "npx cap open android",
    "android:sync": "npx cap sync android",
    "android:run": "npm run build && npx cap sync android && npx cap run android",
    "update-browsers": "npm install caniuse-lite@latest --legacy-peer-deps",
    "generate:joshua": "node scripts/generate-joshua-builtins.mjs --from 2 --to 11 --count 10",
    "quiz:pipeline": "node scripts/run-community-quiz-pipeline.mjs",
    "ship": "node scripts/build-and-push.mjs"
  },
