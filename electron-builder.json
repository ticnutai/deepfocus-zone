{
  "appId": "com.pashash.studyapp",
  "productName": "למען",
  "directories": {
    "output": "release",
    "buildResources": "electron/build"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "asar": true,
  "win": {
    "icon": "electron/build/icon.ico",
    "target": [
      { "target": "nsis", "arch": ["x64"] }
    ],
    "artifactName": "lemaan-setup-${version}.${ext}"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "ticnutai",
      "repo": "deepfocus-zone",
      "releaseType": "release"
    }
  ],
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "למען"
  },
  "portable": {
    "artifactName": "lemaan-portable-${version}.${ext}"
  },
  "mac": {
    "target": ["dmg"],
    "category": "public.app-category.education"
  },
  "linux": {
    "target": ["AppImage"],
    "category": "Education"
  }
}
